# ============================================
# NEXORA - Environment Variables
# ============================================
# Copy this file to .env and fill in values

# --- DATABASE ---
POSTGRES_USER=nexora
POSTGRES_PASSWORD=nexora_secret_change_me
POSTGRES_DB=nexora
DATABASE_URL=postgresql://nexora:nexora_secret_change_me@localhost:5432/nexora

# --- REDIS ---
REDIS_PASSWORD=redis_secret_change_me
REDIS_URL=redis://:redis_secret_change_me@localhost:6379

# --- JWT ---
JWT_SECRET=your_jwt_secret_min_32_chars_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_change_me
JWT_REFRESH_EXPIRES_IN=7d

# --- APP ---
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# --- EMAIL (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@nexora.com

# --- GOOGLE OAUTH (optional) ---
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- STRIPE ---
STRIPE_SECRET_KEY=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
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# --- PAYPAL ---
PAYPAL_CLIENT_ID=EEOztuh2swTWfz6JIqTC-yNuKETNr4byZDEUg6VfttiP0HBv93re7QWeJoWth0o2Yq6zWg--h75jhvF4
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=live
NEXT_PUBLIC_PAYPAL_CLIENT_ID=EEOztuh2swTWfz6JIqTC-yNuKETNr4byZDEUg6VfttiP0HBv93re7QWeJoWth0o2Yq6zWg--h75jhvF4

# --- AWS S3 (optional, for file uploads) ---
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nexora-uploads

# --- SIGNED URLS ---
SIGNED_URL_SECRET=your_signed_url_secret_min_32_chars
SIGNED_URL_EXPIRY=3600

# --- FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
